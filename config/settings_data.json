    "custom_css": [
      "/* 11-13-2025 - Style \"As Seen On\" badge */ /* Retina‑Optimized CSS for Social Icons */ /* Wrapper */.as-seen-badge-icons {display: flex; justify-content: center; align-items: center; gap: 24px; flex-wrap: wrap;}",
      " /* Icon defaults */.as-seen-badge__img {height: 48px; /* consistent height */ max-width: 120px; /* prevents wide logos from looking huge */ width: auto; object-fit: contain; image-rendering: -webkit-optimize-contrast; transition: transform 0.2s ease, opacity 0.2s ease; opacity: 0.9;}",
      " /* Hover effect */.as-seen-badge__img:hover {transform: scale(1.1); opacity: 1;}",
      " /* Mobile override */@media screen and (max-width: 749px) {.as-seen-badge__img {height: 36px; /* smaller size for mobile */ max-width: 90px; /* scale max-width down too */ } .as-seen-badge-icons {gap: 16px; }}",
      " /* Retina / high-DPI optimization */@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {.as-seen-badge__img {height: 48px; max-width: 120px; }}",
      " /* 9-24-2025 - Add the percentage saved (Percent off) on the same line as the price */.percent-saved-badge {background: #ff4444; color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.8em; font-weight: bold; margin: 0 8px; display: inline-block;}",
      ".price__sale {display: flex; align-items: center; flex-wrap: wrap; gap: 8px;}",
      " /* 11-7-2023 Fix - Account Icon Missing On Mobile */a.header__icon.header__icon--account.link.focus-inset.small-hide {display: flex !important;}",
      " /* 2-8-2023 Make \"Add to cart\" button black */product-form [type=\"submit\"] {color: #ffffff !important; background-color: black !important; font-weight: bolder !important;}"
    ]
