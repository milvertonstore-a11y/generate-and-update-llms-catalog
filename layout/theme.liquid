    <!-- 1-24-2026 - Delay Shopify Inbox chat bubble by 24 seconds -->
    <style id="delay-inbox-style">
      #shopify-chat, .shopify-chat, iframe#dummy-chat-button-iframe {
        display: none !important;
        visibility: hidden !important;
      }
    </style>

    <script>
      (function() {
        const delayTime = 24000;
        function showInbox() {
          const styleTag = document.getElementById('delay-inbox-style');
          if (styleTag) styleTag.remove();
          const chatWidget = document.querySelector('#shopify-chat') ||
                            document.querySelector('.shopify-chat') ||
                            document.querySelector('iframe#dummy-chat-button-iframe');
          if (chatWidget) {
            chatWidget.style.setProperty('display', 'block', 'important');
            chatWidget.style.setProperty('visibility', 'visible', 'important');
          }
        }
        setTimeout(showInbox, delayTime);
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              if (node.id === 'shopify-chat' || node.id === 'dummy-chat-button-iframe') {
                node.style.setProperty('display', 'none', 'important');
              }
            });
          });
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });
        setTimeout(() => observer.disconnect(), delayTime + 500);
      })();
    </script>

    <!-- 2-18-2026 - Master Idle Loader -->
    {%- if content_for_header contains 'tapita-seo-script-tags' -%}{%- include 'tapita-seo-schema' -%}{%- endif -%}

    <script>
      (function() {
        const loadDelayedScripts = () => {
          const inject = (src) => {
            const s = document.createElement('script');
            s.src = src;
            s.defer = true;
            document.body.appendChild(s);
          };

          {%- if settings.predictive_search_enabled -%}
            inject("{{ 'predictive-search.js' | asset_url }}");
          {%- endif -%}

          {%- if settings.cart_type == 'drawer' -%}
            inject("{{ 'cart-drawer.js' | asset_url }}");
          {%- endif -%}

          {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
            inject("{{ 'localization-form.js' | asset_url }}");
          {%- endif -%}

          inject("{{ shop.metafields.CZAT.shopat_script }}");
          inject("https://d1mqdk3pxfmmxi.cloudfront.net/bC6eWkwy9zz1l2yy.js");
          inject("https://cdn.shopify.com/extensions/019ca303-e909-78a0-adca-662e9357a616/xb-sticky-add-to-cart-upsell-452/assets/core_script.js");
          inject("https://milvertons.com/cdn/shopifycloud/shop-js/modules/v2/client.shop-follow-button_DzGbq68Y.en.esm.js");

          {%- if content_for_header contains 'adoric.com' -%}
            {%- render 'adoric-ads' -%}
          {%- endif -%}
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => {
            setTimeout(loadDelayedScripts, 2500);
          }, { timeout: 4000 });
        } else {
          setTimeout(loadDelayedScripts, 3000);
        }
      })();
    </script>

    <!-- MakeAnOffer -->
    <script>
      var makeAnOfferData = (function() {
        var data = {
          product: null,
          cartProducts: [],
          currency_iso_code: "{{ currency.iso_code }}",
          settings: {{ shop.metafields.make_an_offer.user_setting | json }},
          customer_email: "{{ customer.email }}"
        };
        {% if product %}
          data.product = (function() {
            var mf_featured_image = "{{ product.selected_or_first_available_variant.featured_image | default: product.featured_image | img_url: '1024x1024'}}";
            var mf_other_image = "{{ product.images.first | img_url: '1024x1024' }}";
            return {
              title: {{ product.title | json }},
              price: "{{ product.price | money_without_currency }}",
              currency: {{ shop.money_format | json }},
              image: mf_featured_image || mf_other_image,
              variants: {{ product.variants | json }},
              tags: {{ product.tags | json }},
              collections: {{ product.collections | json }},
              url: "{{ product.url | within: collections.all }}",
              available: {{ product.available }}
            }
          })();
        {% endif %}
        {% if cart.items.size > 0 %}
          {% for item in cart.items %}
            data.cartProducts.push((function() {
              return {
                title: {{ item.product.title | json }},
                price: `{{ item.price | money }}`,
                image: "{{ item | img_url: '1024x1024' }}",
                variants: {{ item.variants | json }},
                variant_id: "{{ item.variant.id }}",
                url: "{{ item.url | within: collections.all }}",
                sku: "{{ item.sku }}",
                tags: {{ item.product.tags | json }},
                collections: {{ item.product.collections | json }},
                available: {{ item.product.available }}
              }
            })());
          {% endfor %}
        {% endif %}
        return data;
      })();
    </script>

