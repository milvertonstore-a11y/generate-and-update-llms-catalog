    "custom_liquid_zUUbWF": {
      "type": "custom-liquid",
      "disabled": true,
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is the status of my order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Once you have placed your order, we will send you a confirmation email to track the status of your order.\" \n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I change my order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We can only change orders that have not been processed for shipping yet. Once your order is under the status 'preparing for shipping', 'in transit', or 'delivered', then we cannot accept any edits to your order. To make changes to your order, please email us at sales@milvertons.com\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do you ship to my country?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We ship to most countries around the world although we may not be able to ship to a select few due to logistical reasons.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Where can I track my order?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"You can track your order at <a href='https://milvertons.com/apps/parcelpanel'>Track your order</a>.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long will it take my order to process for shipment?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"All orders are subject to processing time that is separate from the time it takes for a shipment to reach its destination once it has been picked up from our fulfillment center by the applicable carrier. Depending on a number of factors, domestic and international orders may take 2-4 business days (excluding weekends and holidays) to process.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long is the In-Transit time to deliver my package?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"This refers to the time it takes for items to be shipped from warehouse to destination (that is, the In-Transit time). Shipping time starts when your order has been shipped, and does not include processing time. For more information, please refer to our Shipping Policy at <a href='https://milvertons.com/policies/shipping-policy'>Shipping Policy</a>.\nShipping time varies by location. Below are our estimates:\nUnited States (7-21 Business days)\nCanada (12-21 Business days)\nEurope (8-15 Business days)\nAustralia, New Zealand (8-15 Business days)\nCentral & South America (15-30 Business days)\nAsia (10-25 Business days)\nAfrica (15-35 Business days)\nNote: These estimates can be affected by external factors, as such they are not guaranteed and may be subject to change. The delivery can be completed before or after the estimated delivery window.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is your return policy?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Our return policy lasts for 30 days, which means we accept returns and exchanges within 30 days of purchase. If you want to return an item, send an email to sales@milvertons.com within three days after delivery. You will be responsible for paying for your own shipping costs for returning your item. Item must be unused and in the same condition that you received it, with tags attached. It must also be in the original packaging. For more information, please refer to our Return and Refund policy at <a href='https://milvertons.com/policies/refund-policy'>Return and Refund Policy</a>.\"\n      }\n    }\n  ]\n}\n</script>",
        "color_scheme": "",
