        "custom_liquid_9UtyWr": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n/* This snippet displays a seasonal sales badge for products in specific collections. AND always displays 'FREE Shipping within USA' for all products\n\n  Logic:\n  - If the product belongs to either 'womens-shoes-and-bags' or 'shoes-with-matching-bag-sets',\n    show: \"🔥 50+ sold this season\"\n  - Else if the product belongs to either 'dresses' or 'pants',\n    show: \"🔥 20+ sold this season\"\n  - Products outside these four collections will not display any badge.\n\n  Only one badge is shown per product, based on priority.\n*/\n{%- endcomment -%}\n\n{%- assign badge_text = '' -%}\n\n{%- for c in product.collections -%}\n  {%- if c.handle == 'womens-shoes-and-bags' or c.handle == 'shoes-with-matching-bag-sets' -%}\n    {%- assign badge_text = '🔥 50+ sold this season' -%}\n    {%- break -%}\n  {%- endif -%}\n{%- endfor -%}\n\n{%- if badge_text == '' -%}\n  {%- for c in product.collections -%}\n    {%- if c.handle == 'dresses' or c.handle == 'pants' -%}\n      {%- assign badge_text = '🔥 20+ sold this season' -%}\n      {%- break -%}\n    {%- endif -%}\n  {%- endfor -%}\n{%- endif -%}\n\n{%- if badge_text != '' -%}\n  <p class=\"product__text inline-richtext\">{{ badge_text }}</p>\n{%- endif -%}\n\n<!-- Always show free shipping message -->\n{%- comment -%}<p class=\"product__text inline-richtext\">🚚 FREE Shipping within USA</p>{%- endcomment -%}\n<p class=\"product__text inline-richtext\">\n  🚚 FREE Shipping within\n  <img src=\"https://flagcdn.com/16x12/us.png\"\n       alt=\"USA\"\n       style=\"vertical-align:middle; margin:0 4px;\">\n  USA\n</p>"
