        "custom_liquid_UrjPwQ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<!-- 9-4-2024 - Add automated links on product pages to collections they belong to -->\n<div class=\"collections-list\">\n  <h3>Collections:</h3>\n  <div>\n    {% for collection in product.collections %}\n      {% unless collection.title == \"All Products\" or collection.title == \"Milvertons Facebook Shop\" or collection.title == \"Sale\" %}\n        <span class=\"collection-tag\">\n          <a href=\"{{ collection.url }}\" class=\"collection-link\">{{ collection.title }}</a>\n        </span>\n      {% endunless %}\n    {% endfor %}\n  </div>\n</div>\n\n<style>\n  .collections-list {\n    margin-top: 20px;\n  }\n  .collection-tag {\n    display: inline-block;\n    background-color: #f2f2f2;\n    border-radius: 5px;\n    padding: 5px 10px;\n    margin: 5px;\n  }\n  .collection-link {\n    text-decoration: none;\n    color: #333;\n  }\n  .collection-link:hover {\n    text-decoration: underline;\n  }\n</style>"
          }
